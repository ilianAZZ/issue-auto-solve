# --- GitHub ---------------------------------------------------------------
# mode "app" (recommended): the agent gets its own identity, so its comments
# are never confused with yours. mode "token": a personal access token.
GITHUB_AUTH_MODE=app
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
# GITHUB_AUTH_MODE=token
# GITHUB_TOKEN=

# --- Claude ---------------------------------------------------------------
# `claude setup-token` on a machine where you are logged in.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Server ---------------------------------------------------------------
# Generated in state/dashboard.token and printed at startup when left empty.
DASHBOARD_TOKEN=
PORT=8420
PUBLIC_URL=http://localhost:8420

# --- Paths ----------------------------------------------------------------
CONFIG_FILE=./config/issue-auto-solve.yml
STATE_DIR=./state
WORKSPACE_DIR=./workspaces
LOG_DIR=./logs

# --- Notifications (optional) --------------------------------------------
DISCORD_WEBHOOK_URL=
