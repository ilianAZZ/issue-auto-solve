{
  "name": "issue-auto-solve",
  "version": "0.1.0",
  "description": "Self-hosted orchestrator that lets Claude Code work a GitHub backlog on its own, across repositories.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:web && tsc -p tsconfig.json && cp src/db/schema.sql dist/db/schema.sql",
    "build:web": "npm --prefix frontend ci && npm --prefix frontend run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix frontend run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:node22": "NODE_OPTIONS=--experimental-sqlite tsx watch src/index.ts",
    "start:node22": "node --experimental-sqlite dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@octokit/auth-app": "^7.1.0",
    "@octokit/rest": "^21.0.0",
    "fastify": "^5.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
